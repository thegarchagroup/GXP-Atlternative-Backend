# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
APP_ENV=development

# Database: either a full SQLAlchemy URL...
# DATABASE_URL=mysql+pymysql://hotel_app:change-me@localhost:3306/hotel_rooms?charset=utf8mb4
# ...or the individual parts (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotel_rooms
DB_USER=hotel_app
DB_PASSWORD=

# Required: at least 32 random characters.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Set true when the site is served over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# IANA timezone used by the web app to display times (stored in UTC)
HOTEL_TIMEZONE=Asia/Kolkata

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Apply pending migrations on startup (set false to require `python -m migrations.cli migrate`)
AUTO_MIGRATE=true
# Seed default room types and checklists on an empty database
SEED_REFERENCE_DATA=true

# First administrator (only used when no active Front Desk admin exists).
# Remove the password after the first start. Alternative: python -m migrations.cli create-admin
BOOTSTRAP_ADMIN_USER_ID=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Front Desk Administrator

# Departments allowed to perform the final Ready-for-Guest release
# (housekeepers/engineers must also be assigned to the ticket; all checks must pass)
RELEASE_DEPARTMENTS=FRONT_DESK,HOUSEKEEPING,ENGINEERING

BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
